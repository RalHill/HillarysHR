# Hillary's HR Blog — Environment Variables
# Copy this to .env.local in your Next.js project root.
# NEVER commit .env.local to git. It's already in .gitignore by default.

# ── Neon Postgres ─────────────────────────────────────────────────────────────
# Get this from: console.neon.tech → your project → Connection Details → .env
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_OwDp4xnhe1Ei@ep-long-butterfly-ame3r7n2.c-5.us-east-1.aws.neon.tech/neondb?sslmode=require
# ── OpenRouter (Llama) ────────────────────────────────────────────────────────
# Get this from: openrouter.ai → Settings → API Keys → Create Key
# Free tier: 200 requests/day, no credit card needed
OPENROUTER_API_KEY=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

# Which model to use. Free options (append :free):
#   meta-llama/llama-3.3-70b-instruct:free   ← recommended (best quality, free)
#   meta-llama/llama-3.2-3b-instruct:free    ← fastest, lower quality
# Paid options (higher throughput, no daily cap):
#   meta-llama/llama-3.3-70b-instruct        ← ~$0.001 per summary
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Cron Security ─────────────────────────────────────────────────────────────
# A random string that protects your /api/ingest endpoint.
# Generate one: openssl rand -hex 32
# Add this same value to Vercel Environment Variables so the cron job can use it.
CRON_SECRET=generate-a-random-string-here-use-openssl-rand-hex-32

# ── Resend (Email Digest) ─────────────────────────────────────────────────────
# Get this from: resend.com → API Keys
# Free tier: 3,000 emails/month
RESEND_API_KEY=re_b6ov1tEj_EMAkXEpXK8LWVnbhc1AAeW7n

# ── Site URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://hillaryshr.blog
